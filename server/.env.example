# NovaBank Server Configuration (Placeholders only - never commit real secrets)
PORT=3000
NODE_ENV=development

# MongoDB Connection (Atlas free tier replica set or in-memory)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/novabank?retryWrites=true&w=majority

# Demo / Simulation Flag
DEMO_SHOW_OTP=true

# Authentication Secrets (64-byte random hex string)
JWT_ACCESS_SECRET=place_random_64_byte_hex_here
JWT_REFRESH_SECRET=place_random_64_byte_hex_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,capacitor://localhost,http://localhost,https://localhost

# Banking Limits & Configuration
TRANSFER_MIN_AMOUNT_PAISE=100
TRANSFER_MAX_AMOUNT_PAISE=5000000
DAILY_TRANSFER_LIMIT_PAISE=10000000
DEPOSIT_MAX_AMOUNT_PAISE=5000000
MIN_USER_AGE_YEARS=16
STARTING_BALANCE_PAISE=1000000
PIN_MAX_FAILED_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15
TIMEZONE=Asia/Kolkata
